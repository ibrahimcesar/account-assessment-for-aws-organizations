#!/usr/bin/env bash
# Pre-commit hook: regenerate CloudFormation templates whenever CDK source
# files (source/infra/**) change in this commit, then stage the results so
# they are included in the commit automatically.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Check whether any CDK source files are staged
CHANGED=$(git diff --cached --name-only | grep -E '^source/infra/' || true)

if [ -z "$CHANGED" ]; then
  exit 0
fi

echo "[pre-commit] CDK source changed — regenerating CloudFormation templates..."

"$REPO_ROOT/scripts/generate-cfn-templates.sh"

# Stage any updated or new templates
git add "$REPO_ROOT/deployment/cfn-templates/"

echo "[pre-commit] Templates staged."
